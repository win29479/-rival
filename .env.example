# ==========================================
# MATH RIVALS 3D — Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file or secret keys to GitHub.

# Multiplayer transport mode: "ws" (authoritative WebSocket server) or "supabase" (Supabase Realtime + RPC)
VITE_MULTIPLAYER_MODE=ws

# WebSocket Game Server URL (used when VITE_MULTIPLAYER_MODE=ws)
# Leave blank in local Vite dev to automatically use ws://<host>/ws via Vite proxy.
# In production (e.g., Vercel frontend + Render/Railway server), set to: wss://your-server.onrender.com/ws
VITE_WS_URL=

# Supabase Configuration (used when VITE_MULTIPLAYER_MODE=supabase)
# Only use the public anon key on the frontend! NEVER expose service_role keys in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Authoritative WebSocket Server Port (for server/index.ts)
PORT=3001
ALLOWED_ORIGIN=*
